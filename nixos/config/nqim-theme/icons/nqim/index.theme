[Icon Theme]
Name=nqim
Comment=nqim theme - dark squircle folder icons
Inherits=Papirus-Dark,breeze-dark,hicolor
DisplayDepth=32
Example=folder
FollowsColorScheme=false

DesktopDefault=128
DesktopSizes=16,22,32,48,64,128,256
ToolbarDefault=22
ToolbarSizes=16,22,32,48
MainToolbarDefault=22
MainToolbarSizes=16,22,32,48
SmallDefault=16
SmallSizes=16,22,32,48
PanelDefault=128
PanelSizes=16,22,32,48,64,128,256
DialogDefault=48
DialogSizes=16,22,32,48,64,128,256

Directories=scalable/places

[scalable/places]
Size=128
Context=Places
Type=Scalable
MinSize=16
MaxSize=256
